---
import Logo from '../components/Logo.astro';
import Layout from '../layouts/MainLayout.astro';
---

<Layout>
	<Logo alt="Logo" class="logo" />
	<h2>Hello, I'm Grant</h2>
	<p>I make design systems, apps, games, and art.</p>
	<ul>
		<li>
			<a
				href="https://github.com/a-type"
				target="_blank"
				rel="noopener noreferrer">GitHub</a
			>
		</li>
		<li>
			<a
				href="https://bsky.app/profile/gfor.rest"
				target="_blank"
				rel="noopener noreferrer">Bluesky</a
			>
		</li>
		<li>
			<a
				href="https://grant.leaflet.pub"
				target="_blank"
				rel="noopener noreferrer">Blog (Technical)</a
			>
		</li>
	</ul>
</Layout>

<style>
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: var(--m-sp);
		@apply --mx-bg(var(--m-tint-wash));
	}
	li {
		margin-inline: calc(-1 * var(--m-action-p-inline));
		padding: 0;
	}
	a {
		display: flex;
		color: inherit;
		text-decoration: none;
		transition:
			background var(--m-dur) var(--m-ease),
			color var(--m-dur) var(--m-ease),
			box-shadow var(--m-dur) var(--m-ease);
		@apply --mx-action-ambient;
		@apply --mx-hover;
		@apply --mx-focus;
		@apply --mx-disabled;
		@apply --mx-fg(var(--m-tint-heavy));
		&:hover,
		&:focus-visible {
			--mx-bg-applied: inherit;
			--mx-bg-ref: --fn-color-heavier(
				color-mix(var(--mx-bg-applied), var(--m-tint-light) 20%),
				1
			);
		}
	}
	p,
	h2 {
		text-wrap: balance;
	}
	h2 {
		@apply --mx-prose-primary;
		margin-block-end: 0;
	}
	.logo {
		grid-area: logo;
		width: 40px;
		height: 40px;
		stroke: currentColor;
	}
</style>
