---
const { mode } = Astro.params;

export function getStaticPaths() {
	return [
		{ params: { mode: 'resizes-content' } },
		{ params: { mode: 'resizes-viewport' } },
		{ params: { mode: 'overlays-content' } },
	];
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content={`width=device-width, initial-scale=1.0, interactive-widget=${mode}`}
		/>
		<title>Viewport Height Reminder</title>
		<style>
			body {
				margin: 0;
				background-color: white;
				color: black;
			}

			.layout {
				display: flex;
				gap: 2px;
				position: fixed;
				top: 0;
				width: 100%;
			}

			.line {
				position: relative;
				top: 0;
				padding: 4px;
				box-sizing: border-box;
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				white-space: pre;
			}
			.line::before,
			.line::after {
				content: '';
				width: 100%;
				height: 3px;
				left: 0;
				background: black;
				position: absolute;
			}
			.line::before {
				top: 0;
			}
			.line::after {
				bottom: 0;
			}

			.vh {
				height: 100vh;
			}
			.dvh {
				height: 100dvh;
			}
			.svh {
				height: 100svh;
			}
			.lvh {
				height: 100lvh;
			}
			.vk {
				height: calc(100dvh - env(keyboard-inset-height));
			}

			.safe-area {
				& .vh {
					height: calc(100vh - env(safe-area-inset-bottom));
				}
				& .dvh {
					height: calc(100dvh - env(safe-area-inset-bottom));
				}
				& .svh {
					height: calc(100svh - env(safe-area-inset-bottom));
				}
				& .lvh {
					height: calc(100lvh - env(safe-area-inset-bottom));
				}
				& .vk {
					height: calc(
						100dvh -
							max(env(keyboard-inset-height), env(safe-area-inset-bottom))
					);
				}
			}
		</style>
	</head>
	<body>
		<div class="layout">
			<div class="line vh" style="background: #ff000020">vh</div>
			<div class="line dvh" style="background: #00ff0020">dvh</div>
			<div class="line svh" style="background: #0000ff20">svh</div>
			<div class="line lvh" style="background: #9f009f20">lvh</div>
			<div class="line vk" style="background: #ffa50020">vk</div>
			<div id="vv-line" class="line vv" style="background: #00ffff20">vv</div>
		</div>

		<div style="height: 200vh"></div>

		<div
			style="
				position: fixed;
				top: 8px;
				right: 8px;
				background: black;
				border-radius: 8px;
				padding: 8px;
				color: white;
				max-width: 50vw;
				display: flex;
				flex-direction: column;
				gap: 4px;
			"
		>
			<div>Viewport lengths test</div>
			<select
				onchange="location.href=`/util/vh/${this.value}`"
				default-value={mode}
				id="mode-select"
			>
				<option value="resizes-content">resizes-content</option>
				<option value="resizes-viewport">resizes-viewport</option>
				<option value="overlays-content">overlays-content</option>
			</select>
			<input placeholder="keyboard test" />
			<button id="vk-toggle">overlay virtual keyboard</button>
			<div>VV: <span id="vv-width"></span>x<span id="vv-height"></span></div>
			<div id="100vh">100VH: 0px</div>
			<label>
				<input
					type="checkbox"
					onchange="
						document.body.classList.toggle('safe-area', this.checked);
					"
				/>
				use safe area inset
			</label>
		</div>

		<script>
			// @ts-ignore
			document.getElementById('mode-select').value = window.location.pathname
				.split('/')
				.pop();

			const vkToggle = document.getElementById(
				'vk-toggle',
			) as HTMLButtonElement;
			if (!('virtualKeyboard' in navigator)) {
				vkToggle.disabled = true;
				vkToggle.textContent = '🚫 no virtual keyboard API';
			}
			vkToggle.addEventListener('click', () => {
				(navigator as any).virtualKeyboard.overlaysContent = true;
				vkToggle.disabled = true;
				vkToggle.textContent = '✅ overlaying virtual keyboard';
			});

			const vvWidth = document.getElementById('vv-width')!;
			const vvHeight = document.getElementById('vv-height')!;
			const vvLine = document.getElementById('vv-line')!;
			function updateVV() {
				vvWidth.textContent = window.visualViewport!.width.toFixed(0);
				vvHeight.textContent = window.visualViewport!.height.toFixed(0);
				vvLine.style.height = `${window.visualViewport!.height}px`;
			}
			window.visualViewport!.addEventListener('resize', updateVV);
			updateVV();

			const vhDisplay = document.getElementById('100vh')!;
			function updateVH() {
				vhDisplay.textContent = `100VH: ${window.innerHeight}px`;
			}
			window.addEventListener('resize', updateVH);
			updateVH();

			const lines = document.querySelectorAll('.line');
			function updateLine(line: HTMLElement) {
				line.textContent = `${line.className.replace(
					'line ',
					'',
				)}: \n${line.getBoundingClientRect().height.toFixed(0)}px`;
			}
			lines.forEach((line) => {
				updateLine(line as HTMLElement);
				const observer = new ResizeObserver(() => {
					updateLine(line as HTMLElement);
				});
				observer.observe(line);
			});
		</script>
	</body>
</html>
