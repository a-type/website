---
import CloudCanvas from '../clouds/CloudCanvas.astro';
import BaseHead from '../components/BaseHead.astro';
import { getDynamicThemeForPath } from '../stores/dynamicTheme';
export interface Props {
	title?: string;
	description?: string;
}
const { title = 'Grant Forrest', description = 'My website' } = Astro.props;
const theme = getDynamicThemeForPath(Astro.routePattern);
const activeLink = Astro.routePattern;
---

<html
	lang="en"
	class="@mode-color-dynamic"
	style={`--dyn-hue: ${theme.hue}; --dyn-sat: ${theme.saturation};`}
>
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<div class="root">
			<nav id="nav">
				<img src="/images/logo.svg" alt="Logo" class="logo" />
			</nav>
			<main>
				<slot />
			</main>
		</div>

		<CloudCanvas class="cloud" />

		<script>
			import { dynamicTheme } from '../stores/dynamicTheme';
			// connect(preset);

			dynamicTheme.subscribe((theme) => {
				document.documentElement.style.setProperty('--dyn-hue', `${theme.hue}`);
				document.documentElement.style.setProperty(
					'--dyn-sat',
					`${theme.saturation}`,
				);
			});
		</script>
	</body>
</html>

<script>
	import { dynamicTheme } from '../stores/dynamicTheme';

	const nav = document.getElementById('nav');
	dynamicTheme.subscribe((theme) => {
		if (nav) {
			nav.className = theme.overlayClass;
		}
	});
</script>

<style>
	.root {
		min-height: 100vh;

		display: grid;
		grid-template-areas: 'nav' 'content';
		grid-template-columns: auto;
		grid-template-rows: auto 1fr;

		position: relative;
		z-index: 1;
	}

	.logo {
		grid-area: logo;
		width: 40px;
		height: 40px;
		stroke: currentColor;
	}

	.page-title {
		grid-area: title;
		margin: 0;
		font-size: var(--m-fs-md);
		font-weight: var(--m-fw-normal);
		@apply --mx-fg(var(--m-tint-heavy));
	}

	nav {
		grid-area: nav;

		display: grid;
		grid-template-areas: 'logo title' 'logo links';
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		gap: var(--m-sp);

		padding: var(--m-surface-p);
		flex-grow: 0;
		gap: var(--m-sp-sm);
		position: relative;
		@apply --mx-fg(var(--m-gray-ink));
	}

	.nav-links {
		grid-area: links;

		list-style: none;
		display: flex;
		flex-direction: row;
		gap: var(--m-sp);
		padding: 0;
		margin: 0;
		border-radius: var(--m-surface-rd);

		a {
			color: inherit;
			font-weight: var(--m-fw-bold);
			letter-spacing: var(--m-ls-tight);
			@apply --mx-fg(var(--m-tint-heavy));
			text-decoration: none;

			&[data-active] {
				@apply --mx-fg(var(--m-tint-ink));
			}
		}
	}

	main {
		grid-area: content;
		flex: 1;
		padding: var(--m-surface-p);
		display: flex;
		flex-direction: column;
		gap: var(--m-sp-lg);
	}

	.cloud {
		position: fixed;
		z-index: 0;
		@apply --mx-bg(var(--m-tint-wash));
	}
</style>
